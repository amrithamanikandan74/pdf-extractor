# This file is used by `docker compose up` — Docker reads .env from the
# same folder as docker-compose.yml, which is now the project root.
#
# Copy this to .env and fill in the values below:
#   cp .env.example .env

# ── Required secrets ───────────────────────────────────────────────────────────
GROQ_API_KEY=

# A long random secret used to authenticate every API request via X-API-Key header.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# ── Database ────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pdfdb

# ── Search backend ──────────────────────────────────────────────────────────────
# pgvector | elasticsearch — both run by default in docker-compose.yml, this
# just controls which one is preselected. You can switch per extraction in the UI.
SEARCH_BACKEND=pgvector
ELASTICSEARCH_INDEX=pdf_chunks

# ── CORS ────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Never use '*' here.
CORS_ORIGINS=http://localhost,http://localhost:5173

# ── Upload limits ───────────────────────────────────────────────────────────────
# Maximum upload size in bytes (default 10 MiB = 10485760).
MAX_UPLOAD_SIZE=10485760

# ── HTTPS ───────────────────────────────────────────────────────────────────────
# Set to true in production behind a TLS terminator to redirect HTTP → HTTPS.
FORCE_HTTPS=false

# ── Frontend (Vite) ─────────────────────────────────────────────────────────────
# URL of the backend API as seen from the browser.
VITE_API_URL=http://localhost:8000
