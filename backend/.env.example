GROQ_API_KEY=
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pdfdb

# pgvector | elasticsearch
# pgvector matches the default docker-compose.yml (Postgres only).
# Only switch to elasticsearch if you're actually running an ES instance
# (it is not started by docker-compose.yml).
SEARCH_BACKEND=pgvector
EMBEDDING_DIM=384
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=pdf_chunks

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173
