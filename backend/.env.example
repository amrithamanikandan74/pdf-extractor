# ── Required secrets ───────────────────────────────────────────────────────────
GROQ_API_KEY=

# A long random secret used to authenticate every API request via X-API-Key header.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# ── Database ────────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=pdfdb

# Used by the FastAPI backend to connect to Postgres.
# In Docker Compose this is auto-built from the vars above; set it for local dev.
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/pdfdb

# ── Search backend ──────────────────────────────────────────────────────────────
# pgvector | elasticsearch
# pgvector matches the default docker-compose.yml (Postgres only).
# Only switch to elasticsearch if you're actually running an ES instance
# (it is not started by docker-compose.yml).
SEARCH_BACKEND=pgvector
EMBEDDING_DIM=384
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=pdf_chunks

# ── CORS ────────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. Never use '*' here.
CORS_ORIGINS=http://localhost:5173

# ── Upload limits ───────────────────────────────────────────────────────────────
# Maximum upload size in bytes (default 10 MiB = 10485760).
MAX_UPLOAD_SIZE=10485760

# ── HTTPS ───────────────────────────────────────────────────────────────────────
# Set to true in production behind a TLS terminator to redirect HTTP → HTTPS.
FORCE_HTTPS=false

# ── Frontend (Vite) ─────────────────────────────────────────────────────────────
# URL of the backend API as seen from the browser.
VITE_API_URL=http://localhost:8000
